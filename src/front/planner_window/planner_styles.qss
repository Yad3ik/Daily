/*
 * planner_styles.qss — стили главного окна планировщика (PlannerWindow).
 * Склеивается с auth_styles.qss в planner_window.py (общие titleBar, windowSurface, диалоги).
 */

/* --- Базовые настройки --- */
QWidget {
  color: #f7f2f5;
  font-family: "Noto Sans";
  font-size: 11px;
}

/* --- Левый сайдбар (фон рисуется в paintEvent Sidebar) --- */
QFrame#plannerSidebar {
  background: transparent;
  border: none;
  border-bottom-left-radius: 11px;
}

QLabel#sectionCaption {
  color: #c5bdc7;
  font-size: 16px;
  font-weight: 400;
  letter-spacing: 2px;
}

/* --- Переключатель «Календарь» / «Задачи» (ViewSwitcher) --- */
QFrame#viewSwitcherWrap {
  background: transparent;
}

QPushButton#viewSwitchBtn {
  background: rgba(20, 18, 28, 120);
  border: 1px solid transparent;
  border-radius: 14px;
  color: #9c95a1;
  text-align: left;
  min-height: 52px;
}

QPushButton#viewSwitchBtn:hover {
  color: #e8e2ec;
}

QPushButton#viewSwitchBtn[active="true"] {
  background-color: rgba(14, 12, 20, 230);
  border: 1px solid rgba(240, 63, 131, 90);
}

QLabel#viewSwitchLabel {
  font-size: 18px;
  font-weight: 400;
  color: #F6F0F4;
}

QLabel#viewSwitchLabel[active="true"] {
  color: #F03F83;
}

/* --- Список тегов в сайдбаре (только на вкладке календаря) --- */
QFrame#tagRow {
  background: transparent;
}

QLabel#tagDot {
  font-size: 16px;
}

QLabel#tagName {
  color: #F6F0F4;
  font-size: 16px;
  font-weight: 400;
}

QLabel#tagCount {
  color: #8f8798;
  font-size: 14px;
}

/* --- Шапка недели: диапазон дат, стрелки, «+ Событие» --- */
QLabel#weekRangeLabel {
  font-family: "Noto Sans";
  font-size: 24px;
  font-weight: 400;
  color: #F6F0F4;
}

QPushButton#navButton {
  background: transparent;
  border: none;
  color: #c5bdc7;
  font-size: 32px;
  font-weight: 300;
  min-width: 48px;
  min-height: 48px;
  padding: 0;
}

QPushButton#navButton:hover {
  color: #F6F0F4;
  background: transparent;
}

QPushButton#navButton:pressed {
  color: #F03F83;
}

QPushButton#primaryButton {
  background-color: #F03F83;
  color: #F6F0F4;
  border: none;
  border-radius: 14px;
  font-size: 18px;
  font-weight: 500;
  text-align: center;
  padding: 0 26px;
  min-height: 44px;
  max-height: 44px;
}

QPushButton#primaryButton:hover {
  background-color: #FF5A9B;
}

/* --- Вид календаря: прозрачный фон, сетка поверх градиента plannerContent --- */
QWidget#calendarView,
QFrame#weekHeaderBar {
  background: transparent;
}

QFrame#weekGridWrap {
  background: transparent;
  border: 1px solid #2a2530;
  border-radius: 14px;
}

QScrollArea#weekGridScroll,
QScrollArea#weekGridScroll > QWidget > QWidget {
  background: transparent;
  border: none;
}

QWidget#weekGridScrollBody,
QWidget#weekGridCols,
QFrame#timeRuler {
  background: transparent;
}

/* --- Заголовки дней недели над сеткой --- */
QFrame#dayHeaderCell {
  background: transparent;
}

QLabel#dayName {
  color: #6f6875;
  font-size: 13px;
  font-weight: 800;
}

QLabel#dayNumber {
  color: #F6F0F4;
  font-size: 20px;
  font-weight: 700;
}

QLabel#dayNumber[today="true"] {
  color: #F03F83;
}

/* --- Колонка дня и шкала времени --- */
QFrame#dayColumn {
  background: transparent;
  border-left: 1px solid #221e28;
}

QLabel#timeLabel {
  color: #F6F0F4;
  font-size: 14px;
}

/* --- Блок события на сетке (EventBlock); фон/рамка задаются в коде по тегу --- */
QLabel#eventBlockTime,
QLabel#eventBlockTitle,
QLabel#eventBlockTag {
  margin: 0;
  padding: 0;
}

QLabel#eventBlockTime {
  font-size: 11px;
}

QLabel#eventBlockTitle {
  color: #F6F0F4;
  font-size: 13px;
  font-weight: 600;
}

QLabel#eventBlockTag {
  font-size: 10px;
}

/* --- Диалог подтверждения (удаление события) --- */
QDialog#confirmDialog {
  background: transparent;
}

QFrame#confirmDialogSurface {
  background-color: #17151f;
  border: 1px solid #393443;
  border-radius: 16px;
}

QLabel#confirmDialogMessage {
  color: #F6F0F4;
  font-size: 20px;
  font-weight: 500;
}

/* --- Диалог добавления события (AddEventDialog) --- */
QDialog#addEventDialog {
  background: transparent;
}

QDialog#addEventDialog QFrame#windowSurface {
  border-radius: 20px;
}

QDialog#addEventDialog QFrame#titleBar {
  border-top-left-radius: 20px;
  border-top-right-radius: 20px;
}

QFrame#addEventDialogBody {
  background-color: #17151f;
  border-bottom-left-radius: 20px;
  border-bottom-right-radius: 20px;
}

QLabel#dialogHeading {
  font-size: 22px;
  font-weight: 600;
  color: #F6F0F4;
}

QLabel#dialogFieldCaption {
  color: #6f6875;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.2px;
}

QLineEdit#dialogField {
  background-color: #1e1c26;
  border: 1px solid #322d39;
  border-radius: 10px;
  color: #f7f2f6;
  font-size: 14px;
  padding: 12px 14px;
  min-height: 22px;
}

QLineEdit#dialogField:focus {
  border: 1px solid #F03F83;
}

QPushButton#dialogTagChip {
  background-color: #1e1c26;
  border: 1px solid #322d39;
  border-radius: 18px;
  color: #9c95a1;
  font-size: 13px;
  font-weight: 400;
  padding: 8px 16px;
}

QPushButton#dialogTagChip:hover {
  color: #e8e2ec;
  border-color: #4a4354;
}

QPushButton#dialogCancelButton {
  background-color: #1e1c26;
  border: 1px solid #322d39;
  border-radius: 10px;
  color: #c5bdc7;
  font-size: 14px;
  font-weight: 500;
  padding: 10px 22px;
  min-height: 40px;
}

QPushButton#dialogCancelButton:hover {
  color: #F6F0F4;
  border-color: #4a4354;
}

QPushButton#dialogSaveButton {
  background-color: #F03F83;
  border: none;
  border-radius: 10px;
  color: #F6F0F4;
  font-size: 14px;
  font-weight: 600;
  padding: 10px 24px;
  min-height: 40px;
}

QPushButton#dialogSaveButton:hover {
  background-color: #FF5A9B;
}

/* --- Основная область контента (градиент за календарём и задачами) --- */
QFrame#plannerContent {
  background: qlineargradient(
    x1: 0, y1: 0, x2: 1, y2: 1,
    stop: 0 #121018,
    stop: 1 #0e0d13
  );
  border: none;
  border-bottom-right-radius: 11px;
}

/* --- Вкладка «Задачи» --- */
QWidget#tasksView {
  background: transparent;
}

QScrollArea#tasksScroll,
QScrollArea#tasksScroll > QWidget > QWidget {
  background: transparent;
  border: none;
}

QWidget#tasksScrollBody,
QFrame#taskSection {
  background: transparent;
}

QLabel#tasksTitle {
  font-family: "Noto Serif";
  font-size: 32px;
  font-weight: 700;
  color: #F6F0F4;
}

QLabel#countBadge {
  background-color: rgba(240, 63, 131, 55);
  color: #F03F83;
  border-radius: 10px;
  font-size: 12px;
  font-weight: 800;
  padding: 2px 10px;
}

/* --- Поле добавления задачи --- */
QFrame#taskInputWrap {
  background-color: rgba(22, 20, 28, 230);
  border: 1px solid #322d39;
  border-radius: 14px;
}

QLabel#taskInputPlus {
  color: #9c95a1;
  font-size: 28px;
  font-weight: 300;
  background: transparent;
  border: none;
}

QLineEdit#taskInputField {
  background: transparent;
  border: none;
  color: #F6F0F4;
  font-size: 16px;
  selection-background-color: #F03F83;
}

QLineEdit#taskInputField::placeholder {
  color: #6f6875;
  font-size: 16px;
}

QPushButton#taskAddButton {
  background: transparent;
  border: none;
  color: #c5bdc7;
  font-size: 13px;
  font-weight: 500;
  padding: 10px 18px;
  min-height: 36px;
}

QPushButton#taskAddButton:hover {
  color: #F6F0F4;
  background: transparent;
}

/* --- Кольцо прогресса выполненных задач --- */
QFrame#progressRing {
  background: transparent;
}

QLabel#progressText {
  color: #F6F0F4;
  font-size: 11px;
  font-weight: 700;
}

/* --- Фильтры: Все / Активные / Выполненные --- */
QPushButton#filterChip {
  background: rgba(22, 20, 28, 200);
  border: 1px solid #322d39;
  border-radius: 12px;
  color: #9c95a1;
  font-size: 16px;
  font-weight: 500;
  letter-spacing: 0.6px;
  padding: 11px 22px;
  min-height: 44px;
}

QPushButton#filterChip:hover {
  color: #e8e2ec;
}

QPushButton#filterChip[active="true"] {
  background-color: rgba(240, 63, 131, 90);
  border-color: #F03F83;
  color: #F6F0F4;
}

/* --- Секции «В работе» / «Выполнено» --- */
QLabel#sectionTitle {
  color: #6f6875;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 1.2px;
}

QLabel#sectionBadge {
  background-color: #24212b;
  color: #9c95a1;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 700;
  padding: 3px 10px;
  min-width: 24px;
}

/* --- Строка задачи (TaskRow) --- */
QFrame#taskRow {
  background-color: rgba(22, 20, 28, 200);
  border: 1px solid #2a2530;
  border-radius: 12px;
}

QFrame#taskRow:hover {
  border-color: #3d3648;
}

QLabel#taskRowLabel {
  color: #F6F0F4;
  font-size: 18px;
}

QLabel#taskRowLabel[completed="true"] {
  color: #6f6875;
  text-decoration: line-through;
}

QPushButton#taskCheck {
  background: transparent;
  border: 2px solid #4a4354;
  border-radius: 13px;
}

QPushButton#taskCheck[checked="true"] {
  background-color: #F03F83;
  border-color: #F03F83;
  color: #fff;
  font-size: 16px;
  font-weight: 800;
}

QPushButton#taskDelete {
  background: transparent;
  border: none;
  color: #ff5c7a;
  font-size: 12px;
  font-weight: 600;
}

QPushButton#taskDelete:hover {
  color: #ff8aa3;
}

/* --- Общие скроллбары списков --- */
QScrollArea {
  background: transparent;
  border: none;
}

QScrollBar:vertical {
  background: transparent;
  width: 8px;
}

QScrollBar::handle:vertical {
  background: #3a3442;
  border-radius: 4px;
  min-height: 24px;
}

/* --- Правая колонка задач: неделя + сегодня в календаре --- */
QFrame#tasksSidePanel {
  background: transparent;
}

QFrame#weekOverview,
QFrame#todayEventsPanel {
  background-color: rgba(22, 20, 28, 200);
  border: 1px solid #2a2530;
  border-radius: 14px;
  max-width: 340px;
}

QLabel#weekOverviewTitle,
QLabel#todayEventsCaption {
  color: #6f6875;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.2px;
}

QLabel#todayEventsTitle {
  color: #F6F0F4;
  font-size: 13px;
  font-weight: 500;
}

/* --- Мини-календарь недели (WeekOverview) --- */
QFrame#weekDayCell {
  background-color: rgba(30, 28, 38, 120);
  border: 1px solid transparent;
  border-radius: 10px;
}

QFrame#weekDayCell[today="true"] {
  border: 1px solid #F03F83;
  background-color: rgba(240, 63, 131, 25);
}

QLabel#weekDayName {
  color: #6f6875;
  font-size: 11px;
  font-weight: 700;
}

QFrame#weekDayCell[today="true"] QLabel#weekDayName,
QFrame#weekDayCell[today="true"] QLabel#weekDayNumber {
  color: #F03F83;
}

QLabel#weekDayNumber {
  color: #F6F0F4;
  font-size: 16px;
  font-weight: 600;
}

/* --- Точка «есть события» под днём недели --- */
QLabel#weekDayDot {
  background-color: transparent;
  border: 1px solid #6f6875;
  border-radius: 4px;
}

QLabel#weekDayDot[hasEvents="true"] {
  background-color: #6f6875;
  border: none;
}

QLabel#weekDayDot[today="true"][hasEvents="true"] {
  background-color: #F03F83;
  border: none;
}

QLabel#weekDayDot[today="true"][hasEvents="false"] {
  background-color: transparent;
  border: 1px solid rgba(240, 63, 131, 140);
}

/* --- Панель «Сегодня в календаре» --- */
QLabel#todayEventsDot {
  color: #F03F83;
  font-size: 8px;
}

QLabel#todayEventsEmpty {
  color: #6f6875;
  font-size: 12px;
}

QFrame#todayEventRow {
  background: transparent;
}

QLabel#todayEventTime {
  color: #9c95a1;
  font-size: 12px;
}

QLabel#todayEventTitle {
  color: #F6F0F4;
  font-size: 13px;
  font-weight: 500;
}
