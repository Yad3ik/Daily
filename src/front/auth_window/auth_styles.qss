/*
 * auth_styles.qss — стили окна входа и регистрации (AuthWindow).
 * Подключается в auth_window.py; часть правил переиспользуется в planner (склейка QSS).
 */

/* --- Базовые настройки приложения --- */
QWidget {
  color: #f7f2f5;
  font-family: "Noto Sans";
  font-size: 11px;
}

/* Непрозрачный фон корневого окна (без WA_TranslucentBackground — иначе размытие в углах) */
QWidget#authWindow,
QWidget#plannerWindow {
  background-color: #15131a;
}

/* --- Оболочка окна (скругление, рамка) --- */
QFrame#windowSurface {
  background-color: #15131a;
  border: 1px solid #393443;
  border-radius: 11px;
}

/* --- Верхняя панель: заголовок, версия, кнопки свернуть/развернуть/закрыть --- */
QFrame#titleBar {
  background-color: #0f0e14;
  border: none;
  border-top-left-radius: 11px;
  border-top-right-radius: 11px;
}

QLabel#windowTitle {
  color: #928b96;
  font-size: 16px;
  font-weight: 400;
}

QLabel#versionLabel {
  color: #928b96;
  font-size: 14px;
}

QPushButton#titleButton {
  background: transparent;
  border: none;
  color: #eeeaf0;
  font-size: 18px;
  font-weight: 300;
}

QPushButton#titleButton:hover {
  background-color: #24202b;
  border-radius: 6px;
}

/* --- Левая колонка: бренд, слоган, иллюстрация --- */
QFrame#leftPanel {
  background: qlineargradient(
    x1: 0, y1: 0, x2: 1, y2: 1,
    stop: 0 #191720,
    stop: 0.56 #1b1822,
    stop: 1 #231b25
  );
  border: none;
}

/* --- Правая колонка: форма входа/регистрации --- */
QFrame#rightPanel {
  background: qlineargradient(
    x1: 0, y1: 0, x2: 1, y2: 1,
    stop: 0 #15131b,
    stop: 1 #111017
  );
  border-bottom-right-radius: 11px;
}

QLabel#brandName {
  font-family: "Noto Serif";
  font-size: 30px;
  font-weight: 800;
  color: #F6F0F4;
}

QLabel#caption {
  color: #F03F83;
  font-size: 10px;
  font-weight: 800;
}

QLabel#slogan {
  color: #F6F0F4;
  font-size: 36px;
  font-weight: 300;
}

QLabel#description {
  color: rgba(170, 163, 173, 150);
  font-size: 12px;
}

/* --- Демо-карточка «Сегодня» на левой панели --- */
QFrame#scheduleCard {
  background-color: rgba(17, 15, 22, 236);
  border: 1px solid #2e2934;
  border-radius: 11px;
}

QLabel#scheduleHeader {
  color: #aaa2ad;
  font-size: 9px;
  font-weight: 700;
}

QLabel#pinkDot {
  color: #F03F83;
  font-size: 14px;
}

/* --- Строки демо-событий в scheduleCard --- */
QFrame#eventRow_pink,
QFrame#eventRow_purple {
  background-color: #201d27;
  border-radius: 9px;
}

QFrame#eventRow_pink {
  border-left: 3px solid #F03F83;
}

QFrame#eventRow_purple {
  border-left: 3px solid #bc8cff;
}

QLabel#eventTime {
  color: #c5bdc7;
  font-size: 11px;
}

QLabel#eventTitle {
  color: #F6F0F4;
  font-size: 10px;
  font-weight: 400;
}

QLabel#tag_pink {
  background-color: rgba(240, 63, 131, 38);
  color: #F03F83;
  border-radius: 9px;
  font-size: 9px;
  font-weight: 700;
}

QLabel#tag_purple {
  background-color: rgba(119, 91, 171, 55);
  color: #d6bdff;
  border-radius: 9px;
  font-size: 9px;
  font-weight: 700;
}

/* --- Карточка auth: вкладки Войти / Регистрация --- */
QFrame#authCard {
  background-color: rgba(28, 25, 35, 218);
  border: none;
  border-radius: 10px;
}

QFrame#tabsWrap {
  background-color: #17151e;
  border-radius: 8px;
}

QPushButton[active="true"] {
  background-color: #24212b;
  color: #F03F83;
  border: none;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 800;
}

QPushButton[active="false"] {
  background-color: transparent;
  color: #9c95a1;
  border: none;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 600;
}

QPushButton[active="false"]:hover {
  color: #d8d2dc;
}

/* --- Страницы формы (FormPage): заголовки и подписи полей --- */
QLabel#formTitle {
  font-family: "Liberation Sans";
  color: #F6F0F4;
  font-size: 28px;
  font-weight: 400;
}

QLabel#formSubtitle {
  color: rgba(170, 163, 173, 150);
  font-size: 12px;
}

QLabel#fieldLabel {
  color: #f3edf3;
  font-size: 13px;
  font-weight: 800;
}

QLabel#fieldError {
  color: #ff5c7a;
  font-size: 12px;
  font-weight: 600;
}

/* --- Поле ввода AuthInput (иконка + line edit) --- */
QFrame#inputFrame {
  background-color: #1b1921;
  border: 1px solid #322d39;
  border-radius: 9px;
}

QLineEdit#innerInput {
  background-color: transparent;
  border: none;
  color: #f7f2f6;
  font-size: 15px;
  selection-background-color: #F03F83;
}

QLineEdit#innerInput:focus {
  color: #F6F0F4;
}

QPushButton#eyeButton {
  background-color: transparent;
  border: none;
}

QPushButton#eyeButton:hover {
  background-color: #25212b;
  border-radius: 6px;
}

/* --- Основная кнопка «Войти» / «Создать аккаунт» --- */
QPushButton#mainButton {
  background-color: #F03F83;
  color: #F6F0F4;
  border: none;
  border-radius: 8px;
  font-size: 17px;
  font-weight: 600;
}

QPushButton#mainButton:hover {
  background-color: #FF5A9B;
}

QPushButton#mainButton:pressed {
  background-color: #C72F6A;
}
